# Copia este archivo a .env.local y pega la config de tu proyecto Firebase.
# Consola: https://console.firebase.google.com → Proyecto → Configuración → Tus apps → SDK.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = guarda todo en este navegador (útil para probar sin proyecto).
# Déjalo en false cuando ya tengas Firebase.
VITE_USE_LOCAL=false
